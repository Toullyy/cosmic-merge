rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each player (including anonymous/guest Firebase users) can read and
    // write only their own cloud save.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public shop snapshots: anyone can browse, but only the owner can publish.
    match /shops/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
