rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each player (including anonymous/guest Firebase users) can read and
    // write only their own cloud save.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public shop snapshots: anyone can browse, but only the owner can publish.
    match /shops/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Weekly beauty contest: anyone (including guests) can read entries and the
    // weekly summary. Only authenticated users can submit an entry or cast a vote.
    match /contest/{weekKey} {
      allow read: if true;
      match /entries/{entryId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid;
        allow delete: if false;
      }
      match /votes/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
